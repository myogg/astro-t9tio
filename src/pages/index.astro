---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IllacrimoFrame from '../components/IllacrimoFrame.astro';
import { site } from '../config';
import { formatMonthYear } from '../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={site.title} description={site.description}>
  <IllacrimoFrame posts={posts}>
    <div class="blogli">
      <ul>
        {posts.map((post) => (
          <li>
            <h2 class="title is-6">
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="subtitle is-7">{formatMonthYear(post.data.date)}</p>
            {post.data.description && <p class="ill-excerpt">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    </div>
  </IllacrimoFrame>
</BaseLayout>
