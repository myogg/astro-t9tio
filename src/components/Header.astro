---
// Port of `_partial/header.ejs` — used on the index page.
import { site } from '../config';
---

<div class="blog-header">
  <nav
    style="border-bottom: 1px solid rgba(0,0,0,.1); position:fixed; top:0; width:100%; background-color: white; z-index: 10"
  >
    <div
      class="container post-container"
      style="display:flex; align-items:center; justify-content:space-between;"
    >
      <a class="button is-white" href="/" style="padding: 23px 5px">
        <img src="/images/jreey-logo.webp" width="68" height="57" alt="Jreey" />
      </a>
      <a class="button is-white" href="/" style="padding: 23px 5px">
        <strong style="color: #555; font-size: 25px">Blogs</strong>
      </a>
    </div>
  </nav>
  {site.subtitle && <p class="lead blog-description">{site.subtitle}</p>}
</div>
