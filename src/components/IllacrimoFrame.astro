---
import type { CollectionEntry } from 'astro:content';
import { site } from '../config';
import { formatMonthYear } from '../utils/date';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const recentPosts = posts.slice(0, 6);
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].slice(0, 8);
---

<div class="ill-site">
  <header class="ill-header">
    <div class="ill-brand">
      <a class="ill-brand-mark" href="/" aria-label="首页">
        <img src="/favicon/favicon.ico" alt="" width="40" height="40" />
      </a>
      <div class="ill-brand-copy">
        <a class="ill-brand-title" href="/">{site.title}</a>
      </div>
    </div>
    <nav class="ill-nav" aria-label="主导航">
      <a href="/" aria-current="page">首页</a>
      <a href="/rss.xml">RSS 订阅</a>
      <a href={site.authorUrl}>关于作者</a>
    </nav>
  </header>

  <div class="ill-columns">
    <main class="ill-main">
      <slot />
    </main>

    <aside class="ill-middle" aria-label="站点动态">
      <section class="ill-widget">
        <h2>Recent Posts</h2>
        <ul class="ill-link-list">
          {recentPosts.map((post) => (
            <li><a href={`/${post.id}/`}>{post.data.title}</a><small>{formatMonthYear(post.data.date)}</small></li>
          ))}
        </ul>
      </section>

      <section class="ill-widget">
        <h2>Connect Me</h2>
        <p class="ill-widget-note">记录新的文章、日常片段，以及值得留下来的想法。</p>
        <div class="ill-social-links">
          <a href="/rss.xml">RSS</a>
          <a href={site.authorUrl}>GitHub</a>
        </div>
      </section>

      <section class="ill-widget">
        <h2>About</h2>
        <p class="ill-widget-note">{site.description}</p>
      </section>
    </aside>

    <aside class="ill-right" aria-label="站点导航和归档">
      <section class="ill-widget">
        <h2>Pages</h2>
        <ul class="ill-link-list compact">
          <li><a href="/">首页</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
          <li><a href={site.authorUrl}>GitHub</a></li>
        </ul>
      </section>

      <section class="ill-widget">
        <h2>Archives</h2>
        <ul class="ill-link-list compact">
          {years.map((year) => (
            <li><span>{year} 年</span></li>
          ))}
        </ul>
      </section>

      <section class="ill-widget">
        <h2>Meta</h2>
        <ul class="ill-link-list compact">
          <li><a href="/rss.xml">文章 RSS</a></li>
          <li><a href="https://github.com/myogg/astro-t9tio">Theme source</a></li>
        </ul>
      </section>
    </aside>
  </div>
</div>
